{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo Scribe",
  "version": "0.1.2",
  "identifier": "com.echoscribe.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Echo Scribe",
        "width": 1100,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/EchoScribe/recordings/**",
          "$HOME/Library/Application Support/EchoScribe/recordings/source-thumbs/**",
          "$APPDATA/EchoScribe/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/echo-scribe-syscap", "binaries/echo-scribe-screenrec"],
    "category": "Productivity",
    "resources": [
      "resources/tray_idle.png",
      "resources/tray_idle_dark.png",
      "resources/tray_recording.png",
      "resources/tray_recording_dark.png",
      "resources/tray_transcribing.png",
      "resources/tray_transcribing_dark.png",
      "resources/tray_thinking.png",
      "resources/tray_thinking_dark.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "F6FD1D39BE4E52054A6B72E1EC5E90A03F5E5B77",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {}
}
